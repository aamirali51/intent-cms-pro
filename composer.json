{
    "name": "intent/cms",
    "description": "Modern CMS built on Intent Framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "intent/framework": "0.8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "php intent install"
        ],
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    }
}
